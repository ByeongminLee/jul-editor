{
  "name": "@jul-editor/react",
  "version": "0.1.0",
  "description": "React bindings for JulEditor: Editor components, hooks and a read-only document view.",
  "license": "MIT",
  "homepage": "https://github.com/ByeongminLee/jul-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ByeongminLee/jul-editor.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/ByeongminLee/jul-editor/issues"
  },
  "author": "Byeongmin Lee",
  "keywords": [
    "editor",
    "rich-text",
    "wysiwyg",
    "react",
    "markdown",
    "jul"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@jul-editor/core": "workspace:^",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@jul-editor/core": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}

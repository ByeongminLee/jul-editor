{
  "name": "@jul-editor/plugins",
  "version": "0.1.0",
  "description": "Optional JulEditor plugins: chart, diagram, data table, code, code workspace and document diff.",
  "license": "MIT",
  "homepage": "https://byeongminlee.github.io/jul-editor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ByeongminLee/jul-editor.git",
    "directory": "packages/plugins"
  },
  "bugs": {
    "url": "https://github.com/ByeongminLee/jul-editor/issues"
  },
  "author": "Byeongmin Lee",
  "keywords": [
    "editor",
    "react",
    "chart",
    "diagram",
    "table",
    "code-highlight",
    "code-workspace",
    "jul",
    "diff"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chart": {
      "types": "./dist/chart/index.d.ts",
      "import": "./dist/chart/index.js"
    },
    "./diagram": {
      "types": "./dist/diagram/index.d.ts",
      "import": "./dist/diagram/index.js"
    },
    "./table": {
      "types": "./dist/table/index.d.ts",
      "import": "./dist/table/index.js"
    },
    "./code": {
      "types": "./dist/code/index.d.ts",
      "import": "./dist/code/index.js"
    },
    "./code-workspace": {
      "types": "./dist/code-workspace/index.d.ts",
      "import": "./dist/code-workspace/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js"
    },
    "./diff": {
      "types": "./dist/diff/index.d.ts",
      "import": "./dist/diff/index.js"
    },
    "./comments": {
      "types": "./dist/comments/index.d.ts",
      "import": "./dist/comments/index.js"
    },
    "./collaboration": {
      "types": "./dist/collaboration/index.d.ts",
      "import": "./dist/collaboration/index.js"
    },
    "./links": {
      "types": "./dist/links/index.d.ts",
      "import": "./dist/links/index.js"
    },
    "./callout": {
      "types": "./dist/callout/index.d.ts",
      "import": "./dist/callout/index.js"
    },
    "./toggle": {
      "types": "./dist/toggle/index.d.ts",
      "import": "./dist/toggle/index.js"
    },
    "./toc": {
      "types": "./dist/toc/index.d.ts",
      "import": "./dist/toc/index.js"
    },
    "./columns": {
      "types": "./dist/columns/index.d.ts",
      "import": "./dist/columns/index.js"
    },
    "./pages": {
      "types": "./dist/pages/index.d.ts",
      "import": "./dist/pages/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "fast-diff": "^1.3.0"
  },
  "peerDependencies": {
    "@jul-editor/core": "workspace:^",
    "@jul-editor/react": "workspace:^",
    "lowlight": "^3.3.0",
    "mermaid": "^12.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@jul-editor/core": "workspace:*",
    "@jul-editor/react": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "lowlight": "3.3.0",
    "mermaid": "12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.10.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "lowlight": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
